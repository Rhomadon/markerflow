generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model m_raw {
  id_raw             BigInt          @id @default(autoincrement())
  imei               String?         @db.VarChar(15)
  timestamp_received DateTime?
  raw                String?
  remote_address     String?         @db.VarChar(15)
  remote_port        String?         @db.VarChar(5)
  histories          m_raw_history[]
}

model m_raw_history {
  id_history    BigInt    @id @default(autoincrement())
  timestamp_gps DateTime?
  altitude      Int?
  angle         Int?
  data          Json?
  event_id      Int?
  id_raw        BigInt?
  latitude      Float?
  longitude     Float?
  number_data   Int?      @db.SmallInt
  satellites    Int?      @db.SmallInt
  speed         Int?
  raw           m_raw?    @relation(fields: [id_raw], references: [id_raw])

  @@unique([timestamp_gps, longitude, latitude, altitude, angle, satellites, speed, event_id], map: "unique_raw_data")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
